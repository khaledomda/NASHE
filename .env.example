# Copy this file to .env in the repo root (or set these in your host's
# environment/secrets panel — e.g. Replit Secrets) before running the backend.

# Postgres connection string. On Replit, provisioning a database gives you this
# automatically. Elsewhere, a free option is Neon (neon.tech) or Supabase.
DATABASE_URL=postgres://user:password@host:5432/nashe

# Used to sign login tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

NODE_ENV=development

# ─── Video storage (S3-compatible — works with AWS S3 or Cloudflare R2) ─────
# Bucket to upload approved video files into.
S3_BUCKET=
# AWS region (e.g. us-east-1). For Cloudflare R2, use "auto".
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for Cloudflare R2 or another non-AWS S3-compatible provider.
# Example for R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public base URL videos are served from (e.g. an R2 public bucket domain, or
# a CloudFront/S3 website URL). If unset, falls back to the default AWS S3
# virtual-hosted-style URL, which only works if the bucket is public.
S3_PUBLIC_BASE_URL=
